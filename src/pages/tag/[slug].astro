---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/blog/ArchiveView.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`「${term.label}」の記事`} description={term.description || `タグ「${term.label}」の記事一覧`}>
	<ArchiveView
		label="タグ"
		title={term.label}
		description={term.description}
		posts={posts}
		basePath={`/tag/${term.slug}`}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
