---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/blog/ArchiveView.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="記事一覧" description="すべての記事を新しい順に表示します">
	<ArchiveView
		title="記事一覧"
		description="すべての記事を新しい順に表示しています。"
		posts={posts}
		basePath="/posts"
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
