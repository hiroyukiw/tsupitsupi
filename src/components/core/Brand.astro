---
interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
	/** 黒帯（フッターなど）の上に置くとき */
	onInk?: boolean;
}

const { siteTitle, siteLogo, onInk = false } = Astro.props;
---

<a href="/" class:list={["brand", onInk && "brand--on-ink"]}>
	{
		siteLogo?.url ? (
			<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="brand__logo" />
		) : (
			<>
				<svg class="brand__mark" viewBox="0 0 120 120" aria-hidden="true">
					<!-- シジュウカラの黒い頭と、お腹のネクタイ模様 -->
					<circle cx="60" cy="60" r="60" fill="var(--logo-ring)" />
					<clipPath id="brand-mark-clip"><circle cx="60" cy="60" r="54" /></clipPath>
					<g clip-path="url(#brand-mark-clip)">
						<rect width="120" height="120" fill="var(--logo-belly)" />
						<rect width="120" height="57" fill="var(--logo-ink)" />
						<rect x="52" y="50" width="16" height="70" fill="var(--logo-ink)" />
					</g>
				</svg>
				<span class="brand__name">{siteTitle}</span>
			</>
		)
	}
</a>

<style>
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		flex: none;
		color: var(--color-ink);
	}

	.brand:hover {
		color: var(--color-ink);
	}

	.brand--on-ink,
	.brand--on-ink:hover {
		color: var(--color-on-ink);
	}

	.brand__mark {
		width: 34px;
		height: 34px;
	}

	:global(:root.dark) .brand:not(.brand--on-ink),
	:global(:root.dark) .brand:not(.brand--on-ink):hover {
		color: var(--color-text);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .brand:not(.brand--on-ink),
		:global(:root:not(.light)) .brand:not(.brand--on-ink):hover {
			color: var(--color-text);
		}
	}

	.brand__name {
		font-size: 1.35rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.brand__logo {
		max-height: 40px;
		width: auto;
	}
</style>
