---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings, extractPlainText } from "emdash";
import Base from "../../layouts/Base.astro";
import PageView from "../../components/core/PageView.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

// 「home」はトップページとして表示する
if (slug === "home") {
	return Astro.redirect("/", 301);
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// 管理画面の SEO 欄で説明文を入れていなければ、本文の最初の部分を説明文にする
const bodyText = extractPlainText(page.data.content ?? []).replace(/\s+/g, " ").trim();
const description = seo.description || (bodyText ? `${bodyText.slice(0, 110)}${bodyText.length > 110 ? "…" : ""}` : null);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageView data={page.data} titleEdit={page.edit.title} />
</Base>
