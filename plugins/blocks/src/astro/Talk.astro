---
/** 吹き出し：アイコンと名前つきで会話を見せる。向きは左右を選べる */
interface Props {
	node: { icon?: string; name?: string; side?: string; text?: string };
}

const { node } = Astro.props;
const side = node.side === "right" ? "right" : "left";
const name = node.name?.trim() ?? "";
const text = node.text?.trim();
const icon = node.icon?.trim();
---

{
	text && (
		<div class:list={["ts-talk", `ts-talk--${side}`]}>
			<figure class="ts-talk__who">
				{icon ? (
					<img class="ts-talk__icon" src={icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
				) : (
					<span class="ts-talk__icon ts-talk__icon--blank" aria-hidden="true">
						{name.slice(0, 1)}
					</span>
				)}
				{name && <figcaption class="ts-talk__name">{name}</figcaption>}
			</figure>
			<p class="ts-talk__bubble">{text}</p>
		</div>
	)
}

<style>
	.ts-talk {
		--talk-icon: 4rem;
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-4);
		margin-block: var(--spacing-6);
	}

	.ts-talk--right {
		flex-direction: row-reverse;
	}

	.ts-talk__who {
		flex: none;
		width: var(--talk-icon);
		margin: 0;
		text-align: center;
	}

	.ts-talk__icon {
		display: grid;
		place-items: center;
		width: var(--talk-icon);
		height: var(--talk-icon);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		object-fit: cover;
		background: var(--color-fill);
	}

	.ts-talk__icon--blank {
		color: var(--color-muted);
		font-weight: 700;
	}

	.ts-talk__name {
		margin-block-start: var(--spacing-1);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.ts-talk__bubble {
		position: relative;
		min-width: 0;
		margin: 0;
		padding: var(--spacing-3) var(--spacing-4);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		white-space: pre-line;
	}

	/* しっぽ：枠線の三角の上に、背景色の三角を重ねる */
	.ts-talk__bubble::before,
	.ts-talk__bubble::after {
		content: "";
		position: absolute;
		top: calc(var(--talk-icon) / 2 - 0.5rem);
		border: 0.5rem solid transparent;
	}

	.ts-talk--left .ts-talk__bubble::before {
		right: 100%;
		border-right-color: var(--color-border-strong);
	}

	.ts-talk--left .ts-talk__bubble::after {
		right: calc(100% - 1px);
		border-right-color: var(--color-surface);
	}

	.ts-talk--right .ts-talk__bubble::before {
		left: 100%;
		border-left-color: var(--color-border-strong);
	}

	.ts-talk--right .ts-talk__bubble::after {
		left: calc(100% - 1px);
		border-left-color: var(--color-surface);
	}
</style>
