---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";
import Columns from "../components/core/Columns.astro";
import Breadcrumbs from "../components/core/Breadcrumbs.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// 全文検索（FTS）を使う。記事が増えても速いまま
const { items: results, nextCursor } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [], nextCursor: undefined };

function escapeHtml(text: string) {
	return text
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
}

// 抜粋がタイトルそのものなら、強調をタイトル側に付けて抜粋は出さない
const rows = results.map((result) => {
	const title = result.title ?? "（タイトルなし）";
	const snippetIsTitle =
		result.snippet?.replaceAll("<mark>", "").replaceAll("</mark>", "") === escapeHtml(title);
	return {
		path: `/posts/${result.slug ?? result.id}`,
		title,
		titleHtml: snippetIsTitle ? result.snippet : undefined,
		snippet: snippetIsTitle ? undefined : result.snippet,
	};
});

const countLabel = nextCursor ? `上位 ${rows.length} 件` : `${rows.length} 件`;
---

<Base
	title={query ? `「${query}」の検索結果` : "サイト内検索"}
	description="サイト内の記事を検索します"
	robots="noindex, follow"
>
	<div class="container">
		<Breadcrumbs items={[{ label: "サイト内検索" }]} />
	</div>
	<Columns>
		<section class="panel search">
			<h1 class="page-title">サイト内検索</h1>
			<form method="get" action="/search" role="search" class="widget-search search__form">
				<label for="search-query" class="sr-only">キーワード</label>
				<input
					id="search-query"
					type="search"
					name="q"
					value={query}
					placeholder="キーワードを入力"
					autofocus={!query}
				/>
				<button type="submit" class="btn">検索</button>
			</form>
			{!query && <p class="page-lead">記事のタイトルと本文から探します。</p>}
		</section>

		{
			query &&
				(rows.length > 0 ? (
					<section aria-labelledby="search-result-title">
						<h2 id="search-result-title" class="search__summary">
							「{query}」の検索結果：{countLabel}
						</h2>
						<ol class="row-list">
							{rows.map((row) => (
								<li class="search__result">
									<a href={row.path} class="search__link">
										{row.titleHtml ? <Fragment set:html={row.titleHtml} /> : row.title}
									</a>
									{row.snippet && <p class="search__snippet" set:html={row.snippet} />}
								</li>
							))}
						</ol>
					</section>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">「{query}」に一致する記事はありませんでした</h2>
						<p class="empty-state__text">別のキーワードで試すか、記事一覧から探してください。</p>
						<div class="empty-state__actions">
							<a href="/posts" class="btn btn--outline">記事一覧へ</a>
						</div>
					</div>
				))
		}
	</Columns>
</Base>

<style>
	.search {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.search__summary {
		margin-block-end: var(--spacing-4);
		font-size: var(--font-size-base);
	}

	.search__result {
		padding: var(--spacing-4) var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.search__link {
		font-weight: 700;
		color: var(--color-text);
	}

	.search__link:hover {
		color: var(--color-brand);
	}

	.search__snippet {
		margin-block-start: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.search :global(mark),
	.search__result :global(mark) {
		background: var(--color-accent-soft);
		color: var(--color-on-accent-soft);
	}
</style>
