---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteHeader from "../components/core/SiteHeader.astro";
import SiteDrawer from "../components/core/SiteDrawer.astro";
import SiteFooter from "../components/core/SiteFooter.astro";
import FormLabelsJa from "../components/core/FormLabelsJa.astro";
import MobileBar from "../components/core/MobileBar.astro";
import WebAnalytics from "../components/core/WebAnalytics.astro";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/forms.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

// メニューは管理画面の「メニュー」で編集する
//   primary    … グローバルナビ（PC）
//   mobile     … スマホのサイドメニュー（空なら primary を表示）
//   cta        … ヘッダーとサイドメニューの目立つボタン
//   mobile-bar … スマホの画面下部に固定するメニュー（4つまで）
//   footer     … フッターのリンク
const [settingsResult, ...menuResults] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("mobile"),
	getMenuWithCacheHint("cta"),
	getMenuWithCacheHint("mobile-bar"),
	getMenuWithCacheHint("footer"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	for (const result of menuResults) Astro.cache.set(result.cacheHint);
}
const [primaryItems, mobileItems, ctaItems, mobileBarItems, footerItems] = menuResults.map(
	(result) => result.data?.items ?? [],
);

const settings = settingsResult.data;
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(settings);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;

const SOCIAL_LABELS: Record<string, string> = {
	twitter: "X",
	facebook: "Facebook",
	instagram: "Instagram",
	youtube: "YouTube",
	github: "GitHub",
	linkedin: "LinkedIn",
};
const social = (settings as { social?: Record<string, string | undefined> }).social ?? {};
const socialLinks = Object.entries(SOCIAL_LABELS)
	.filter(([key]) => social[key])
	.map(([key, label]) => ({ label, url: social[key] as string }));

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// 管理画面でファビコンを設定していなければ、テーマのロゴマークを使う
const hasFavicon = !!(settings as { favicon?: { url?: string } }).favicon?.url;
const isLoggedIn = !!Astro.locals.user;
const lang = getSiteLocale() ?? "ja";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{
			!hasFavicon && (
				<>
					{/* SVG に対応していないブラウザや検索エンジン向けに .ico、iPhone のホーム画面用に PNG も出す */}
					<link rel="icon" href="/favicon.ico" sizes="48x48" />
					<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
					<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
				</>
			)
		}
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
		<script is:inline>
			// 保存された表示モードを先に当てて、ちらつきを防ぐ
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
		<WebAnalytics />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">本文へ移動</a>
		<SiteHeader
			siteTitle={siteTitle}
			siteLogo={siteLogo}
			navItems={primaryItems}
			ctaItems={ctaItems}
			isLoggedIn={isLoggedIn}
		/>
		<SiteDrawer
			menuItems={mobileItems.length > 0 ? mobileItems : primaryItems}
			ctaItems={ctaItems}
			socialLinks={socialLinks}
		/>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<SiteFooter
			siteTitle={siteTitle}
			siteTagline={siteTagline}
			siteLogo={siteLogo}
			footerItems={footerItems}
			socialLinks={socialLinks}
		/>
		<MobileBar items={mobileBarItems} />
		<EmDashBodyEnd page={pageCtx} />
		<FormLabelsJa />
	</body>
</html>
