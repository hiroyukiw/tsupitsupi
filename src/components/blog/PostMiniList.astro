---
/** サイドバー向けの小さな記事リスト（サムネイル＋タイトル） */
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { formatDate } from "../../utils/locale";

interface Props {
	posts: ContentEntry<InferCollectionData<"posts">>[];
	/** 1, 2, 3… の順位を付ける */
	ranked?: boolean;
	showDate?: boolean;
}

const { posts, ranked = false, showDate = false } = Astro.props;
---

{
	posts.length > 0 ? (
		<ol class="mini-list">
			{posts.map((post, index) => (
				<li class="mini-list__item">
					<a href={`/posts/${post.id}`} class="mini-list__link">
						<span class="mini-list__thumb">
							{post.data.featured_image && (
								<Image image={post.data.featured_image} sizes="72px" />
							)}
							{ranked && <span class="mini-list__rank">{index + 1}</span>}
						</span>
						<span class="mini-list__text">
							<span class="mini-list__title">{post.data.title}</span>
							{showDate && post.data.publishedAt && (
								<time class="mini-list__date" datetime={post.data.publishedAt.toISOString()}>
									{formatDate(post.data.publishedAt, "short")}
								</time>
							)}
						</span>
					</a>
				</li>
			))}
		</ol>
	) : (
		<p class="mini-list__empty">まだ記事がありません。</p>
	)
}

<style>
	.mini-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
		list-style: none;
	}

	.mini-list__link {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		color: var(--color-text);
	}

	.mini-list__link:hover .mini-list__title {
		color: var(--color-brand);
	}

	.mini-list__thumb {
		position: relative;
		flex: none;
		width: 72px;
		aspect-ratio: 1;
		border-radius: var(--radius);
		background: var(--color-fill);
	}

	.mini-list__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.mini-list__rank {
		position: absolute;
		inset-block-start: -6px;
		inset-inline-start: -6px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		border-radius: var(--radius-full);
		background: var(--color-ink);
		color: var(--color-on-ink);
		font-size: var(--font-size-label);
		font-weight: 700;
	}

	.mini-list__text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.mini-list__title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1.6;
		transition: color var(--transition-fast);
	}

	.mini-list__date,
	.mini-list__empty {
		font-size: var(--font-size-label);
		color: var(--color-muted);
	}
</style>
