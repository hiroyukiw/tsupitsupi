---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug, type TaxonomyTerm } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveView from "../../components/blog/ArchiveView.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", { includeCounts: false });

// カテゴリーは親子構造なので、子カテゴリーまでたどって探す
function findTerm(terms: TaxonomyTerm[], target: string): TaxonomyTerm | undefined {
	for (const term of terms) {
		if (term.slug === target) return term;
		const child = findTerm(term.children ?? [], target);
		if (child) return child;
	}
	return undefined;
}
const term = slug ? findTerm(termsResult.data, slug) : undefined;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={term.label} description={term.description || `「${term.label}」の記事一覧`}>
	<ArchiveView
		label="カテゴリー"
		title={term.label}
		description={term.description}
		posts={posts}
		basePath={`/category/${term.slug}`}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
