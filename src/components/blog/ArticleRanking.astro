---
/** 記事内ブロック「ランキング」。1ブロックが1商品。順位・画像・評価・説明・購入ボタンを出す */
const node = Astro.props.node ?? {};

const rank = Number.isFinite(Number(node.rank)) && Number(node.rank) > 0 ? Math.floor(Number(node.rank)) : null;
const name = typeof node.name === "string" ? node.name.trim() : "";
const image = typeof node.image === "string" && node.image ? node.image : null;
const rating = Math.min(5, Math.max(0, Number(node.rating) || 0));
const text = String(node.text ?? "").trim();
const buttonUrl = typeof node.button_url === "string" && /^https?:\/\//.test(node.button_url.trim()) ? node.button_url.trim() : null;
const buttonLabel = (typeof node.button_label === "string" && node.button_label.trim()) || "詳しく見る";

// 星は 0.5 刻みで、塗りの割合を幅で表す
const ratingPercent = `${(Math.round(rating * 2) / 2 / 5) * 100}%`;
const medal = rank !== null && rank <= 3 ? `article-ranking--rank-${rank}` : null;
---

<section class:list={["article-ranking", medal]}>
	<header class="article-ranking__head">
		{rank !== null && <span class="article-ranking__rank">{rank}<small>位</small></span>}
		{name && <p class="article-ranking__name">{name}</p>}
	</header>
	<div class="article-ranking__body">
		{image && <img class="article-ranking__image" src={image} alt={name} loading="lazy" />}
		<div class="article-ranking__detail">
			{
				rating > 0 && (
					<p class="article-ranking__rating">
						<span class="article-ranking__stars" style={`--rating: ${ratingPercent}`} aria-hidden="true">
							★★★★★
						</span>
						<span class="article-ranking__score">{rating.toFixed(1)}</span>
						<span class="sr-only">（5点中 {rating.toFixed(1)} 点）</span>
					</p>
				)
			}
			{text && <p class="article-ranking__text">{text}</p>}
			{
				buttonUrl && (
					<a class="btn article-ranking__button" href={buttonUrl} target="_blank" rel="sponsored nofollow noopener">
						{buttonLabel}
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.article-ranking {
		--rank-color: var(--color-ink);

		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		overflow: hidden;
	}

	.article-ranking--rank-1 {
		--rank-color: var(--color-rank-1);
	}

	.article-ranking--rank-2 {
		--rank-color: var(--color-rank-2);
	}

	.article-ranking--rank-3 {
		--rank-color: var(--color-rank-3);
	}

	.article-ranking__head {
		display: flex;
		align-items: center;
		gap: 0.75em;
		padding: 0.6em 1em;
		border-bottom: 3px solid var(--rank-color);
		background: var(--color-fill);
	}

	.article-ranking__rank {
		flex: none;
		display: inline-flex;
		align-items: baseline;
		justify-content: center;
		min-width: 2.6em;
		padding: 0.2em 0.5em;
		border-radius: var(--radius-full);
		background: var(--rank-color);
		color: var(--color-on-ink);
		font-weight: var(--font-weight-display);
		line-height: 1.4;
	}

	.article-ranking__rank small {
		margin-left: 0.1em;
		font-size: 0.7em;
	}

	.article-ranking__name {
		margin: 0;
		color: var(--color-text);
		font-size: 1.1em;
		font-weight: var(--font-weight-heading);
		line-height: 1.4;
	}

	.article-ranking__body {
		display: grid;
		gap: 1em;
		padding: 1em;
	}

	@media (min-width: 640px) {
		.article-ranking__body:has(.article-ranking__image) {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		}
	}

	.article-ranking__image {
		width: 100%;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		object-fit: cover;
		background: var(--color-fill);
	}

	.article-ranking__detail {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		min-width: 0;
	}

	.article-ranking__rating {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin: 0;
	}

	.article-ranking__stars {
		position: relative;
		color: var(--color-border-strong);
		letter-spacing: 0.1em;
		line-height: 1;
	}

	.article-ranking__stars::before {
		content: "★★★★★";
		position: absolute;
		inset: 0;
		width: var(--rating);
		overflow: hidden;
		color: var(--color-star);
		white-space: nowrap;
	}

	.article-ranking__score {
		color: var(--color-text);
		font-weight: var(--font-weight-heading);
	}

	.article-ranking__text {
		margin: 0;
		white-space: pre-line;
	}

	/* 本文のリンク色（.prose a）に負けないように、ボタンの文字色をここで決める */
	.article-ranking__button,
	.article-ranking__button:hover {
		align-self: stretch;
		margin-top: auto;
		color: var(--color-on-brand);
		text-decoration: none;
	}
</style>
