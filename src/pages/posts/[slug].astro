---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import Columns from "../../components/core/Columns.astro";
import Breadcrumbs from "../../components/core/Breadcrumbs.astro";
import Byline from "../../components/blog/Byline.astro";
import PostGrid from "../../components/blog/PostGrid.astro";
import ShareButtons from "../../components/blog/ShareButtons.astro";
import Toc from "../../components/blog/Toc.astro";
import WidgetArea from "../../components/widgets/WidgetArea.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { normalizeLayout } from "../../utils/layout";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// OGP 用のアイキャッチ URL（外部 URL か、アップロードした画像）
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	return storageKey ? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}` : undefined;
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: getImageUrl(post.data.featured_image),
});

const layout = normalizeLayout(post.data.layout);
const bylines = post.data.bylines ?? [];
const readingTime = getReadingTime(post.data.content);
const tags = post.data.terms?.tag ?? [];
const category = post.data.terms?.category?.[0];
const publishedAt = post.data.publishedAt ?? null;
const updatedAt = post.data.updatedAt ?? null;
const showUpdated =
	!!publishedAt && !!updatedAt && updatedAt.toDateString() !== publishedAt.toDateString();

// 前後の記事（公開日順）。新しい記事の数が多いときは表示しない
const { entries: timeline, cacheHint: timelineHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 50,
});
if (Astro.cache?.enabled) Astro.cache.set(timelineHint);
const position = timeline.findIndex((entry) => entry.id === post.id);
const newer = position > 0 ? timeline[position - 1] : undefined;
const older = position >= 0 ? timeline[position + 1] : undefined;

// 関連記事：同じカテゴリーの新しい記事
const { entries: sameCategory, cacheHint: relatedHint } = category
	? await getEmDashCollection("posts", {
			where: { category: category.slug },
			orderBy: { published_at: "desc" },
			limit: 4,
		})
	: { entries: [], cacheHint: undefined };
if (Astro.cache?.enabled && relatedHint) Astro.cache.set(relatedHint);
const related = sameCategory.filter((entry) => entry.id !== post.id).slice(0, 3);

// 見出しがあれば目次の場所を先に確保しておく（実際の目次はスクリプトで作る）
const hasHeadings = (post.data.content ?? []).some(
	(block) =>
		block._type === "block" && "style" in block && (block.style === "h2" || block.style === "h3"),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={updatedAt?.toISOString() ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="container">
		<Breadcrumbs
			items={[
				...(category ? [{ label: category.label, href: `/category/${category.slug}` }] : []),
				{ label: post.data.title },
			]}
		/>
	</div>

	<Columns layout={layout}>
		<article class="panel post">
			<header class="post__header">
				{category && <a href={`/category/${category.slug}`} class="chip">{category.label}</a>}
				<h1 class="page-title" {...post.edit.title}>{post.data.title}</h1>
				<p class="post__meta">
					{
						publishedAt && (
							<span>
								公開日 <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "short")}</time>
							</span>
						)
					}
					{
						showUpdated && updatedAt && (
							<span>
								更新日 <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt, "short")}</time>
							</span>
						)
					}
					<span>{readingTime}分で読めます</span>
				</p>
			</header>

			{
				post.data.featured_image && (
					<div class="post__hero" {...post.edit.featured_image}>
						<Image
							image={post.data.featured_image}
							sizes="(min-width: 1000px) 760px, 92vw"
							priority
						/>
					</div>
				)
			}

			{hasHeadings && <Toc id="toc-inline" />}

			<div class="prose" data-post-content {...post.edit.content}>
				<PortableText value={post.data.content} />
			</div>

			{
				tags.length > 0 && (
					<ul class="pill-list post__tags" aria-label="タグ">
						{tags.map((tag) => (
							<li><a href={`/tag/${tag.slug}`} class="pill">{tag.label}</a></li>
						))}
					</ul>
				)
			}

			<ShareButtons url={Astro.url.href} title={post.data.title} />

			{
				bylines.length > 0 && (
					<section class="post__author" aria-label="この記事を書いた人">
						<p class="post__author-label">この記事を書いた人</p>
						<Byline bylines={bylines} layout="list" />
					</section>
				)
			}

			<WidgetArea name="post-bottom" />

			{
				(newer || older) && (
					<nav class="post__pager" aria-label="前後の記事">
						{older ? (
							<a href={`/posts/${older.id}`} class="post__pager-link">
								<span class="post__pager-label">前の記事</span>
								<span class="post__pager-title">{older.data.title}</span>
							</a>
						) : <span />}
						{newer && (
							<a href={`/posts/${newer.id}`} class="post__pager-link post__pager-link--next">
								<span class="post__pager-label">次の記事</span>
								<span class="post__pager-title">{newer.data.title}</span>
							</a>
						)}
					</nav>
				)
			}
		</article>

		{
			related.length > 0 && (
				<section aria-labelledby="related-title">
					<div class="section-head">
						<h2 id="related-title" class="section-head__title">関連記事</h2>
					</div>
					<PostGrid posts={related} />
				</section>
			)
		}

		<section class="panel post__comments" aria-labelledby="comments-title">
			<h2 id="comments-title" class="sr-only">コメント</h2>
			<Comments
				collection="posts"
				contentId={post.data.id}
				threaded
				labels={{
					heading: (count) => (count === 0 ? "コメントはまだありません" : `コメント（${count}件）`),
					member: "サイトメンバー",
					like: "いいね",
				}}
			/>
			<CommentForm
				collection="posts"
				contentId={post.data.id}
				labels={{
					name: "お名前",
					email: "メールアドレス（公開されません）",
					comment: "コメント",
					submit: "コメントを送信",
					submitting: "送信中…",
					published: "コメントを公開しました。",
					pending: "コメントを受け付けました。承認後に表示されます。",
					error: "送信できませんでした。入力内容を確認してください。",
					networkError: "通信エラーが発生しました。時間をおいて再度お試しください。",
				}}
			/>
		</section>

		{hasHeadings && <Toc id="toc-side" slot="side" boxed />}
	</Columns>
</Base>

<style>
	.post {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.post__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
	}

	.post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) var(--spacing-4);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.post__hero :global(img) {
		width: 100%;
		border-radius: var(--radius);
	}

	.post__author {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		padding: var(--spacing-5);
		border-radius: var(--radius-card);
		background: var(--color-fill);
	}

	.post__author-label {
		font-size: var(--font-size-sm);
		font-weight: 700;
	}

	.post__pager {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-3);
	}

	.post__pager-link {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: var(--spacing-3) var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
	}

	.post__pager-link:hover {
		border-color: var(--color-brand);
	}

	.post__pager-link--next {
		text-align: end;
	}

	.post__pager-label {
		font-size: var(--font-size-label);
		color: var(--color-muted);
	}

	.post__pager-title {
		font-size: var(--font-size-sm);
		font-weight: 700;
	}

	.post__comments {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}
</style>
