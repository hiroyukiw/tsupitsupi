---
/**
 * 強み・バナー・スライド。
 * 強み: 番号付きで横に並べる / バナー: 画像付きのリンクカード / スライド: 横にスクロール
 */
import { Image } from "emdash/ui";
import { type BlockProps, str, hasImage } from "./types";

type Props = BlockProps;

const { value, area } = Astro.props;
const style = str(value.style) || "強み";
const variant = style === "バナー" ? "banners" : style === "スライド" ? "slider" : "points";
const heading = str(value.heading);
const items = (Array.isArray(value.items) ? value.items : [])
	.filter((item): item is Record<string, unknown> => !!item && typeof item === "object")
	.map((item) => ({
		title: str(item.title),
		text: str(item.text),
		url: str(item.url),
		image: hasImage(item.image) ? item.image : null,
	}))
	.filter((item) => item.title);
---

{
	items.length > 0 && (
		<section class:list={["features", `features--${variant}`, area === "full" && "features--full"]}>
			<div class:list={[area === "full" && "container"]}>
				{heading && <h2 class="section-head__title features__heading">{heading}</h2>}
				<ul class="features__list" tabindex={variant === "slider" ? 0 : undefined} aria-label={variant === "slider" ? heading || "スライド" : undefined}>
					{items.map((item, index) => {
						const inner = (
							<>
								{variant === "points" ? (
									<span class="features__num" aria-hidden="true">{index + 1}</span>
								) : (
									<span class="features__image">
										{item.image && <Image image={item.image} sizes="(min-width: 1000px) 280px, 80vw" />}
									</span>
								)}
								<span class="features__text">
									<span class="features__title">{item.title}</span>
									{item.text && <span class="features__desc">{item.text}</span>}
								</span>
							</>
						);
						return (
							<li class="features__item">
								{item.url ? <a href={item.url} class="features__card">{inner}</a> : <div class="features__card">{inner}</div>}
							</li>
						);
					})}
				</ul>
			</div>
		</section>
	)
}

<style>
	.features--full {
		padding-block: var(--spacing-8);
		background: var(--color-surface);
		border-block-end: 1px solid var(--color-border);
	}

	.features--full.features--banners,
	.features--full.features--slider {
		background: transparent;
		border: 0;
		padding-block: var(--spacing-10) 0;
	}

	.features__heading {
		margin-block-end: var(--spacing-5);
	}

	.features__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-4);
		list-style: none;
	}

	.features--slider .features__list {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-block-end: var(--spacing-3);
	}

	.features--slider .features__item {
		flex: 0 0 min(300px, 80%);
		scroll-snap-align: start;
	}

	.features__card {
		display: flex;
		gap: var(--spacing-3);
		height: 100%;
		color: var(--color-text);
	}

	a.features__card:hover .features__title {
		color: var(--color-brand);
	}

	.features--banners .features__card,
	.features--slider .features__card {
		flex-direction: column;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.features--banners .features__text,
	.features--slider .features__text {
		padding: var(--spacing-3) var(--spacing-4) var(--spacing-4);
	}

	.features__num {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--color-brand-soft);
		color: var(--color-brand);
		font-weight: 900;
	}

	.features__image {
		display: block;
		aspect-ratio: 16 / 9;
		background: var(--color-fill);
	}

	.features__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.features__text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.features__title {
		font-weight: 700;
		transition: color var(--transition-fast);
	}

	.features__desc {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		line-height: 1.7;
	}
</style>
