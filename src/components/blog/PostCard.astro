---
import { Image } from "emdash/ui";
import { formatDate } from "../../utils/locale";
import type { PostEntry, TermLink } from "../../utils/post-terms";

interface Props {
	post: PostEntry;
	category?: TermLink;
	/** card: カード（グリッド用） / row: 横長のリスト */
	variant?: "card" | "row";
	headingLevel?: 2 | 3;
	/** 一番上に表示される画像だけ優先して読み込む */
	priority?: boolean;
}

const { post, category, variant = "card", headingLevel = 3, priority = false } = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/posts/${post.id}`;
const title = post.data.title || "（タイトルなし）";
const publishedAt = post.data.publishedAt ?? null;
const sizes =
	variant === "card" ? "(min-width: 1000px) 260px, (min-width: 600px) 45vw, 100vw" : "160px";
---

<article class:list={["post-card", `post-card--${variant}`]}>
	<a href={href} class="post-card__media" tabindex="-1" aria-hidden="true">
		{
			post.data.featured_image ? (
				<Image image={post.data.featured_image} sizes={sizes} priority={priority} />
			) : (
				<span class="post-card__placeholder" />
			)
		}
	</a>
	<div class="post-card__body">
		{category && <a href={`/category/${category.slug}`} class="chip post-card__category">{category.label}</a>}
		<Heading class="post-card__title" {...post.edit.title}>
			<a href={href}>{title}</a>
		</Heading>
		{
			variant === "row" && post.data.excerpt && (
				<p class="post-card__excerpt">{post.data.excerpt}</p>
			)
		}
		{
			publishedAt && (
				<time class="post-card__date" datetime={publishedAt.toISOString()}>
					{formatDate(publishedAt, "short")}
				</time>
			)
		}
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
		transition: box-shadow var(--transition-base), translate var(--transition-base);
	}

	.post-card:hover {
		box-shadow: var(--shadow-card-hover);
		translate: 0 -2px;
	}

	.post-card__media {
		display: block;
		aspect-ratio: 16 / 9;
		background: var(--color-fill);
	}

	.post-card__media :global(img),
	.post-card__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-2);
		padding: var(--spacing-4) var(--spacing-4) var(--spacing-5);
	}

	.post-card__category {
		position: relative;
		z-index: 1;
	}

	.post-card__title {
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: 1.6;
	}

	.post-card__title a {
		color: var(--color-text);
	}

	/* カード全体をクリックできるように */
	.post-card__title a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post-card__title a:hover {
		color: var(--color-brand);
	}

	.post-card__excerpt {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card__date {
		margin-block-start: auto;
		font-size: var(--font-size-label);
		color: var(--color-muted);
	}

	.post-card--row {
		flex-direction: row;
		align-items: stretch;
	}

	.post-card--row .post-card__media {
		flex: none;
		width: clamp(112px, 28%, 220px);
		aspect-ratio: auto;
		min-height: 100px;
	}

	.post-card--row .post-card__body {
		padding: var(--spacing-3) var(--spacing-4);
		gap: 6px;
	}

	.post-card--row .post-card__date {
		margin-block-start: 0;
	}

	/* スマホでは、カード一覧の2件目以降を横長にして縦の長さを抑える */
	@media (max-width: 599px) {
		:global(.card-grid > li:not(:first-child)) .post-card--card {
			flex-direction: row;
		}

		:global(.card-grid > li:not(:first-child)) .post-card--card .post-card__media {
			flex: none;
			width: 112px;
			aspect-ratio: auto;
			min-height: 88px;
		}

		:global(.card-grid > li:not(:first-child)) .post-card--card .post-card__body {
			padding: var(--spacing-3);
			gap: 4px;
		}

		:global(.card-grid > li:not(:first-child)) .post-card--card .post-card__title {
			font-size: var(--font-size-sm);
		}

		:global(.card-grid > li:not(:first-child)) .post-card--card .post-card__date {
			margin-block-start: 0;
		}

		.post-card--row .post-card__title {
			font-size: var(--font-size-sm);
		}

		.post-card--row .post-card__excerpt {
			display: none;
		}
	}
</style>
