---
interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
	/** 黒帯（フッターなど）の上に置くとき */
	onInk?: boolean;
}

const { siteTitle, siteLogo, onInk = false } = Astro.props;
---

<a href="/" class:list={["brand", onInk && "brand--on-ink"]}>
	{
		siteLogo?.url ? (
			<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="brand__logo" />
		) : (
			<>
				<svg class="brand__mark" viewBox="0 0 36 36" aria-hidden="true">
					<circle cx="18" cy="18" r="17" fill="currentColor" />
					<ellipse cx="21" cy="19" rx="8" ry="7" fill="var(--color-surface)" />
					<circle cx="20" cy="16" r="1.8" fill="currentColor" />
					<path d="M10 15 L5 17 L10 18 Z" fill="currentColor" />
					<rect x="16" y="24" width="4" height="10" rx="2" fill="var(--color-brand)" />
				</svg>
				<span class="brand__name">{siteTitle}</span>
			</>
		)
	}
</a>

<style>
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		flex: none;
		color: var(--color-ink);
	}

	.brand:hover {
		color: var(--color-ink);
	}

	.brand--on-ink,
	.brand--on-ink:hover {
		color: var(--color-on-ink);
	}

	.brand__mark {
		width: 34px;
		height: 34px;
	}

	.brand--on-ink .brand__mark ellipse {
		fill: var(--color-ink);
	}

	:global(:root.dark) .brand:not(.brand--on-ink),
	:global(:root.dark) .brand:not(.brand--on-ink):hover {
		color: var(--color-text);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .brand:not(.brand--on-ink),
		:global(:root:not(.light)) .brand:not(.brand--on-ink):hover {
			color: var(--color-text);
		}
	}

	.brand__name {
		font-size: 1.35rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.brand__logo {
		max-height: 40px;
		width: auto;
	}
</style>
