---
/**
 * トップページ。
 *
 * 固定ページ「home」（スラッグ home）の内容を表示する。ブロックの追加・並べ替えは
 * 管理画面の 固定ページ > ホーム で行う。home がない場合は新着記事を表示する。
 */
import { getEmDashEntry, getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/core/PageView.astro";
import Columns from "../components/core/Columns.astro";
import PostGrid from "../components/blog/PostGrid.astro";
import WidgetArea from "../components/widgets/WidgetArea.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entry: home, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

const fallbackPosts = home
	? []
	: (await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12 })).entries;
---

<Base title={siteTitle} description={siteTagline}>
	{
		home ? (
			<PageView data={home.data} isHome>
				<WidgetArea name="home-after-posts" />
			</PageView>
		) : (
			<Columns>
				<section>
					<div class="section-head">
						<h2 class="section-head__title">新着記事</h2>
						<a href="/posts" class="section-head__more">すべて見る</a>
					</div>
					{fallbackPosts.length > 0 ? (
						<PostGrid posts={fallbackPosts} priority />
					) : (
						<div class="empty-state">
							<h2 class="empty-state__title">まだ記事がありません</h2>
							<p class="empty-state__text">管理画面から最初の記事を書きましょう。</p>
							<div class="empty-state__actions">
								<a href="/_emdash/admin/content/posts/new" class="btn">記事を書く</a>
							</div>
						</div>
					)}
				</section>
				<WidgetArea name="home-after-posts" />
			</Columns>
		)
	}
</Base>
