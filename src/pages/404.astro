---
import Base from "../layouts/Base.astro";
import Columns from "../components/core/Columns.astro";
---

<Base title="ページが見つかりません" robots="noindex">
	<Columns>
		<section class="panel not-found">
			<p class="chip">404</p>
			<h1 class="page-title">ページが見つかりません</h1>
			<p class="page-lead">お探しのページは、移動または削除された可能性があります。</p>
			<form method="get" action="/search" role="search" class="widget-search">
				<label for="not-found-query" class="sr-only">キーワード</label>
				<input id="not-found-query" type="search" name="q" placeholder="キーワードで検索" />
				<button type="submit" class="btn">検索</button>
			</form>
			<div class="not-found__actions">
				<a href="/" class="btn">ホームへ戻る</a>
				<a href="/posts" class="btn btn--outline">記事一覧へ</a>
			</div>
		</section>
	</Columns>
</Base>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
	}

	.not-found .widget-search {
		width: 100%;
		max-width: 480px;
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}
</style>
